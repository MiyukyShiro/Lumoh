{
  "name": "lumo",
  "version": "1.0.0",
  "private": true,
  "description": "Lumo — The Sound of My Mind",
  "scripts": {
    "setup": "npm i @capacitor/core@7 @capacitor/cli@7 @capacitor/android@7 @capacitor/local-notifications@7",
    "add:android": "npx cap add android",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  }
}
